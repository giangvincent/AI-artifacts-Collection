{
  "mcpServers": {
    "headroom": {
      "transport": "stdio",
      "command": "~/.local/bin/headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "agentmemory": {
      "transport": "stdio",
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_SECRET": "REDACTED"
      }
    },
    "private-app": {
      "transport": "stdio",
      "enabled": true,
      "command": "node",
      "args": [
        "~/Documents/private-app-app/dist/mcp/bridge.js"
      ]
    }
  }
}
